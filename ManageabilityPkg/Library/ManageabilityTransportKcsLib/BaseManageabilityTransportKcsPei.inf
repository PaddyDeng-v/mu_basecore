[Defines]
  INF_VERSION                    = 0x0001001B
  BASE_NAME                      = ManageabilityTransportKcsPei
  MODULE_UNI_FILE                = ManageabilityTransportKcs.uni
  FILE_GUID                      = 25EF81E3-053C-4AF7-AD97-BAB9DF28DEAD
  MODULE_TYPE                    = PEIM
  VERSION_STRING                 = 1.0
  LIBRARY_CLASS                  = ManageabilityTransportLib|PEIM

#
#  VALID_ARCHITECTURES           = IA32 X64 AARCH64
#

[Sources]
  ManageabilityTransportKcs.c
  KcsCommon.c
  ManageabilityTransportKcs.h
  ManageabilityTransportKcsPei.c

[Packages]
  ManageabilityPkg/ManageabilityPkg.dec
  MdePkg/MdePkg.dec

[LibraryClasses]
  DebugLib
  IoLib
  TimerLib
  MemoryAllocationLib
  HobLib
  BaseMemoryLib
  PeiServicesLib

[Ppis]
  gEfiPeiMemoryDiscoveredPpiGuid  # PPI SOMETIMES CONSUMES

[Guids]
  gManageabilityTransportKcsGuid
  gManageabilityProtocolMctpGuid
  gManageabilityProtocolIpmiGuid
  gManageabilityKcsInfoHobGuid

[FixedPcd]
  gEfiMdePkgTokenSpaceGuid.PcdIpmiKcsIoBaseAddress                        # Used as default KCS I/O base adddress
  gManageabilityPkgTokenSpaceGuid.PcdIpmiKcsIoCmdAddress
  gManageabilityPkgTokenSpaceGuid.PcdKcsStatusCheckTimeout                 # Use the predefined timeout value in micro seconds
